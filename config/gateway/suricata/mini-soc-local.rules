# Mini-SOC local Suricata signatures
#
# GitHub-governed source for the local lab signatures deployed on SOC-GW-01.
# Runtime deployment target:
#   /var/lib/suricata/rules/mini-soc-local.rules
#
# CHG-019 — deterministic authorized ICMP signal.
alert icmp 10.77.0.10 any -> 10.77.0.1 any (msg:"MINI-SOC Authorized ICMP Detection Test"; itype:8; sid:1000001; rev:1;)

# CHG-025 — bounded ICMP rate anomaly, detection-only.
# Generates at most one alert per one-second window after 20 matches from the
# authorized test source. This is not an IPS/drop rule and does not trigger
# Active Response during CHG-025.
alert icmp 10.77.0.10 any -> 10.77.0.1 any (msg:"MINI-SOC Controlled ICMP Rate Anomaly"; itype:8; threshold:type both, track by_src, count 20, seconds 1; sid:1000002; rev:1;)
