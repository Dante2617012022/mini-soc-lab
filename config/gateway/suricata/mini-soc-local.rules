# Mini-SOC local Suricata signatures
#
# GitHub-governed source for the local lab signatures deployed on SOC-GW-01.
# Runtime deployment target:
#   /var/lib/suricata/rules/mini-soc-local.rules
#
# CHG-019 — deterministic authorized ICMP signal.
alert icmp 10.77.0.10 any -> 10.77.0.1 any (msg:"MINI-SOC Authorized ICMP Detection Test"; itype:8; sid:1000001; rev:1;)

# CHG-025 — bounded UDP rate anomaly, detection-only.
# Uses a dedicated UDP destination port so CHG-025 traffic cannot satisfy the
# existing CHG-019 SID 1000001 / CHG-021 Active Response trigger.
alert udp 10.77.0.10 any -> 10.77.0.1 65000 (msg:"MINI-SOC Controlled UDP Rate Anomaly"; threshold:type threshold, track by_src, count 20, seconds 1; sid:1000002; rev:1;)
